@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix http: <http://www.w3.org/2011/http#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shaclmate: <http://purl.org/shaclmate/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shaclmate:NodeShape
    sh:property shaclmate:NodeShape-discriminantValue, shaclmate:NodeShape-extern, shaclmate:NodeShape-fromRdfType, shaclmate:NodeShape-rdfType, shaclmate:NodeShape-toRdfTypes, shaclmate:NodeShape-tsImports, shaclmate:Shape-ignore, shaclmate:Shape-mutable, shaclmate:Shape-shaclmateName .

shaclmate:NodeShape-discriminantValue
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:discriminantValue .

shaclmate:NodeShape-extern
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path shaclmate:extern .

shaclmate:NodeShape-fromRdfType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:fromRdfType .

shaclmate:NodeShape-rdfType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:rdfType .

shaclmate:NodeShape-toRdfTypes
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:toRdfType .

shaclmate:NodeShape-tsImports
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:name "tsImports" ;
    sh:path shaclmate:tsImport .

shaclmate:Operation
    a rdfs:Class, sh:NodeShape ;
    sh:property shaclmate:Operation-error, shaclmate:Operation-httpMethodName, shaclmate:Operation-httpRequestURI, shaclmate:Operation-name, shaclmate:Operation-parameter, shaclmate:Operation-result, shaclmate:comment, shaclmate:label .

shaclmate:Operation-error
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:NodeShape ;
    sh:path shaclmate:error .

shaclmate:Operation-httpMethodName
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path http:methodName .

shaclmate:Operation-httpRequestURI
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path http:requestURI .

shaclmate:Operation-name
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:name .

shaclmate:Operation-parameter
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:NodeShape ;
    sh:path shaclmate:parameter .

shaclmate:Operation-result
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:PropertyShape ;
    sh:path shaclmate:result .

shaclmate:PropertyShape
    sh:property shaclmate:PropertyShape-display, shaclmate:PropertyShape-resolve, shaclmate:Shape-ignore, shaclmate:Shape-mutable, shaclmate:Shape-shaclmateName .

shaclmate:PropertyShape-display
    a sh:PropertyShape ;
    rdfs:comment "Whether to include this property in a toString()-type display, defaults to false" ;
    sh:datatype xsd:boolean ;
    sh:defaultValue false ;
    sh:maxCount 1 ;
    sh:path shaclmate:display .

shaclmate:PropertyShape-resolve
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:name "resolve" ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path shaclmate:resolve .

shaclmate:Service
    a rdfs:Class, sh:NodeShape ;
    sh:property shaclmate:Service-name, shaclmate:Service-operations, shaclmate:comment, shaclmate:label .

shaclmate:Service-name
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:name .

shaclmate:Service-operations
    a sh:PropertyShape ;
    sh:node shaclmate:Operation ;
    sh:path shaclmate:operation .

shaclmate:Shape-ignore
    a sh:PropertyShape ;
    rdfs:comment "Whether to ignore this shape in code generation, defaults to false" ;
    sh:datatype xsd:boolean ;
    sh:defaultValue false ;
    sh:maxCount 1 ;
    sh:path shaclmate:ignore .

shaclmate:Shape-mutable
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path shaclmate:mutable .

shaclmate:Shape-shaclmateName
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:name "shaclmateName" ;
    sh:path shaclmate:name .

