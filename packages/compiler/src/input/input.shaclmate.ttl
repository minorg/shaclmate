@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shaclmate: <http://purl.org/shaclmate/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shaclmate:HttpRequestMethod
    a sh:NodeShape ;
    sh:in ( "DELETE" "GET" "POST" "PUT" ) .

shaclmate:HttpRequestContentType
    a sh:NodeShape ;
    sh:in ( "application/json" ) .

shaclmate:HttpResponseContentType
    a sh:NodeShape ;
    sh:in ( "application/json" ) .

shaclmate:HttpResponseStatusCode
    a sh:NodeShape ;
    sh:datatype xsd:int ;
    sh:maxCount 1 ;
    sh:maxInclusive 599 ;
    sh:minInclusive 100 .

shaclmate:HttpOperationBinding
    a rdfs:Class, sh:NodeShape ;
    sh:property shaclmate:HttpOperationBinding-request, shaclmate:HttpOperationBinding-response .

shaclmate:HttpOperationBinding-request
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:HttpOperationBindingRequest ;
    sh:path shaclmate:request .

shaclmate:HttpOperationBinding-response
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:HttpOperationBindingResponse ;
    sh:path shaclmate:response .

shaclmate:HttpOperationBindingRequest
    a sh:NodeShape ;
    sh:maxCount 1 ;
    sh:property shaclmate:HttpOperationBindingRequest-contentType, shaclmate:HttpOperationBindingRequest-method, shaclmate:HttpOperationBindingRequest-urlTemplate .

shaclmate:HttpOperationBindingRequest-contentType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:HttpRequestContentType ;
    sh:path schema:encodingType .

shaclmate:HttpOperationBindingRequest-method
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:HttpRequestMethod ;
    sh:path schema:httpMethod .

shaclmate:HttpOperationBindingRequest-urlTemplate
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path schema:urlTemplate .

shaclmate:HttpOperationBindingResponse
    a sh:NodeShape ;
    sh:maxCount 1 ;
    sh:property shaclmate:HttpOperationBindingResponse-contentType, shaclmate:HttpOperationBindingResponse-statusCode .

shaclmate:HttpOperationBindingResponse-contentType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:HttpResponseContentType ;
    sh:path schema:contentType .

shaclmate:HttpOperationBindingResponse-statusCode
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:HttpResponseStatusCode ;
    sh:path shaclmate:httpStatusCode .

shaclmate:NodeShape
    sh:property shaclmate:NodeShape-discriminantValue, shaclmate:NodeShape-extern, shaclmate:NodeShape-fromRdfType, shaclmate:NodeShape-rdfType, shaclmate:NodeShape-toRdfTypes, shaclmate:NodeShape-tsImports, shaclmate:Shape-ignore, shaclmate:Shape-mutable, shaclmate:Shape-shaclmateName .

shaclmate:NodeShape-discriminantValue
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:discriminantValue .

shaclmate:NodeShape-extern
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path shaclmate:extern .

shaclmate:NodeShape-fromRdfType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:fromRdfType .

shaclmate:NodeShape-rdfType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:rdfType .

shaclmate:NodeShape-toRdfTypes
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:toRdfType .

shaclmate:NodeShape-tsImports
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:name "tsImports" ;
    sh:path shaclmate:tsImport .

shaclmate:Operation
    a rdfs:Class, sh:NodeShape ;
    sh:property shaclmate:Operation-bindings, shaclmate:Operation-error, shaclmate:Operation-name, shaclmate:Operation-parameter, shaclmate:Operation-result, shaclmate:comment, shaclmate:label .

shaclmate:Operation-bindings
    a sh:PropertyShape ;
    sh:node shaclmate:HttpOperationBinding ;
    sh:path shaclmate:binding .

shaclmate:Operation-error
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:NodeShape ;
    sh:path shaclmate:error .

shaclmate:Operation-binding
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:binding .

shaclmate:Operation-name
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:name .

shaclmate:Operation-parameter
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:NodeShape ;
    sh:path shaclmate:parameter .

shaclmate:Operation-result
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:node shaclmate:PropertyShape ;
    sh:path shaclmate:result .

shaclmate:PropertyShape
    sh:property shaclmate:PropertyShape-display, shaclmate:PropertyShape-resolve, shaclmate:Shape-ignore, shaclmate:Shape-mutable, shaclmate:Shape-shaclmateName .

shaclmate:PropertyShape-display
    a sh:PropertyShape ;
    rdfs:comment "Whether to include this property in a toString()-type display, defaults to false" ;
    sh:datatype xsd:boolean ;
    sh:defaultValue false ;
    sh:maxCount 1 ;
    sh:path shaclmate:display .

shaclmate:PropertyShape-resolve
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:name "resolve" ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path shaclmate:resolve .

shaclmate:Service
    a rdfs:Class, sh:NodeShape ;
    sh:property shaclmate:Service-name, shaclmate:Service-operations, shaclmate:comment, shaclmate:label .

shaclmate:Service-name
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:name .

shaclmate:Service-operations
    a sh:PropertyShape ;
    sh:node shaclmate:Operation ;
    sh:path shaclmate:operation .

shaclmate:Shape-ignore
    a sh:PropertyShape ;
    rdfs:comment "Whether to ignore this shape in code generation, defaults to false" ;
    sh:datatype xsd:boolean ;
    sh:defaultValue false ;
    sh:maxCount 1 ;
    sh:path shaclmate:ignore .

shaclmate:Shape-mutable
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path shaclmate:mutable .

shaclmate:Shape-shaclmateName
    shaclmate:display true ;
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:name "shaclmateName" ;
    sh:path shaclmate:name .

