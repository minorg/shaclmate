@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shaclmate: <http://purl.org/shaclmate/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shaclmate:HttpRequestMethod
    a sh:NodeShape ;
    rdfs:comment "Enumeration of common HTTP request methods" ;
    sh:in ("DELETE"
        "GET"
        "POST"
        "PUT"
    ) .

shaclmate:HttpResponseErrorStatusCode
    a sh:NodeShape ;
    rdfs:comment "Enumeration of both client error (4xx) and server error (5xx) response codes" ;
    sh:datatype xsd:int ;
    sh:in (400
        401
        402
        403
        404
        405
        406
        407
        408
        409
        410
        411
        412
        413
        414
        415
        416
        417
        418
        421
        422
        423
        424
        425
        426
        428
        429
        431
        451
        500
        501
        502
        503
        504
        505
        506
        507
        508
        510
        511
    ) .

shaclmate:HttpResponseSuccessfulStatusCode
    a sh:NodeShape ;
    rdfs:comment "Enumeration of HTTP successful (2xx) status codes" ;
    sh:datatype xsd:int ;
    sh:in (200
        201
        202
        203
        204
        205
        206
        207
        208
        226
    ) .

shaclmate:NodeShape
    sh:property shaclmate:NodeShape-discriminantValue, shaclmate:NodeShape-extern, shaclmate:NodeShape-fromRdfType, shaclmate:NodeShape-rdfType, shaclmate:NodeShape-toRdfTypes, shaclmate:NodeShape-tsImports, shaclmate:Shape-ignore, shaclmate:Shape-mutable, shaclmate:Shape-shaclmateName .

shaclmate:NodeShape-discriminantValue
    a sh:PropertyShape ;
    rdfs:comment """The type discriminant value to use when a type in a discriminated union needs to be wrapped in a discriminant envelope.

Example:

    sh:xone ([
            shaclmate:discriminantValue \"date\" ;
            sh:datatype xsd:date
        ]
        [
            shaclmate:discriminantValue \"dateTime\" ;
            sh:datatype xsd:dateTime
        ]
    )

Because xsd:date and xsd:dateTime are both Date in JavaScript, the generated discriminated union needs to be wrapped in an envelope like:

{ $type: 'type1'; value: Date } | { $type: 'type2'; value: Date }

in order to discriminate values at runtime. With shaclmate:discriminantValue from the example above, the generated type would be:

{ $type: 'date'; value: Date } | { $type: 'dateTime'; value: Date }
""" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:discriminantValue .

shaclmate:NodeShape-extern
    a sh:PropertyShape ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path shaclmate:extern .

shaclmate:NodeShape-fromRdfType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:fromRdfType .

shaclmate:NodeShape-rdfType
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:rdfType .

shaclmate:NodeShape-toRdfTypes
    a sh:PropertyShape ;
    sh:nodeKind sh:IRI ;
    sh:path shaclmate:toRdfType .

shaclmate:NodeShape-tsImports
    a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:name "tsImports" ;
    sh:path shaclmate:tsImport .

shaclmate:Operation
    a rdfs:Class, sh:NodeShape ;
    rdfs:comment "Service operation" ;
    sh:property shaclmate:Operation-bindings, shaclmate:Operation-error, shaclmate:Operation-name, shaclmate:Operation-parameter, shaclmate:Operation-result, shaclmate:comment, shaclmate:label .

shaclmate:Operation-bindings
    a sh:PropertyShape ;
    rdfs:comment "Transport bindings for the operation, loosely modeled after WSDL. If no bindings are specified the operation will be excluded from transport client and server generation." ;
    sh:node shaclmate:OperationHttpBinding ;
    sh:path shaclmate:binding .

shaclmate:Operation-error
    a sh:PropertyShape ;
    rdfs:comment "Optional error type(s) associated with the operation. This must be a node shape with properties (a 'struct') or a discriminated union of the same." ;
    sh:maxCount 1 ;
    sh:node shaclmate:NodeShape ;
    sh:path shaclmate:error .

shaclmate:Operation-name
    shaclmate:display true ;
    a sh:PropertyShape ;
    rdfs:comment "Identifier-safe name of the operation, incorporated into generated code." ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:name .

shaclmate:Operation-parameter
    a sh:PropertyShape ;
    rdfs:comment "Optional parameter type. This must be a node shape with properties (a 'struct')." ;
    sh:maxCount 1 ;
    sh:node shaclmate:NodeShape ;
    sh:path shaclmate:parameter .

shaclmate:Operation-result
    a sh:PropertyShape ;
    rdfs:comment "Optional result type. The type is a property shape in order to incorporate cardinality." ;
    sh:maxCount 1 ;
    sh:node shaclmate:PropertyShape ;
    sh:path shaclmate:result .

shaclmate:OperationHttpBinding
    a rdfs:Class, sh:NodeShape ;
    rdfs:comment "HTTP binding for an operation" ;
    sh:property shaclmate:OperationHttpBinding-errorResponses, shaclmate:OperationHttpBinding-request, shaclmate:OperationHttpBinding-resultResponse .

shaclmate:OperationHttpBinding-errorResponses
    a sh:PropertyShape ;
    rdfs:comment "Zero or more HTTP bindings for the errors of an operation. Should be 1:1 with error (structs), although this isn't enforced. Unbound and undeclared errors are mapped to status code 500." ;
    sh:node shaclmate:OperationHttpErrorResponseBinding ;
    sh:path shaclmate:errorResponse .

shaclmate:OperationHttpBinding-request
    a sh:PropertyShape ;
    rdfs:comment "HTTP binding for the parameter of an operation. Must be specified in order to specify the URI template." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:node shaclmate:OperationHttpRequestBinding ;
    sh:path shaclmate:request .

shaclmate:OperationHttpBinding-resultResponse
    a sh:PropertyShape ;
    rdfs:comment "Optional HTTP binding for the result of an operation. If not specified, the result content type is inferred and the status code is 200." ;
    sh:maxCount 1 ;
    sh:node shaclmate:OperationHttpResultResponseBinding ;
    sh:path shaclmate:resultResponse .

shaclmate:OperationHttpErrorResponseBinding
    a sh:NodeShape ;
    rdfs:comment "HTTP binding for an error associated with an operation" ;
    sh:property shaclmate:OperationHttpErrorResponseBinding-error, shaclmate:OperationHttpErrorResponseBinding-statusCode .

shaclmate:OperationHttpErrorResponseBinding-error
    a sh:PropertyShape ;
    rdfs:comment "Pointer (IRI) to the error being bound. The error must be associated with the operation with shaclmate:error." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path schema:error .

shaclmate:OperationHttpErrorResponseBinding-statusCode
    a sh:PropertyShape ;
    rdfs:comment "HTTP client/server error code for the bound error." ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "statusCode" ;
    sh:node shaclmate:HttpResponseErrorStatusCode ;
    sh:path shaclmate:httpStatusCode .

shaclmate:OperationHttpRequestBinding
    a sh:NodeShape ;
    rdfs:comment "HTTP binding for the request (parameter) associated with an operation" ;
    sh:property shaclmate:OperationHttpRequestBinding-contentType, shaclmate:OperationHttpRequestBinding-method, shaclmate:OperationHttpRequestBinding-urlTemplate .

shaclmate:OperationHttpRequestBinding-contentType
    a sh:PropertyShape ;
    rdfs:comment "HTTP request body content type. This should be specified if the operation has parameters that are not bound to its request URI template. If it's not specified it defaults to JSON." ;
    sh:maxCount 1 ;
    sh:node shaclmate:OperationHttpRequestBindingContentType ;
    sh:path schema:encodingType .

shaclmate:OperationHttpRequestBinding-method
    a sh:PropertyShape ;
    rdfs:comment "HTTP request body method. If this is not specified, it's inferred from the existence of path, query, and/or body parameters" ;
    sh:maxCount 1 ;
    sh:node shaclmate:HttpRequestMethod ;
    sh:path schema:httpMethod .

shaclmate:OperationHttpRequestBinding-urlTemplate
    a sh:PropertyShape ;
    rdfs:comment "RFC 6570 URI template for the HTTP request. Variables in the template must correspond to properties of the parameter. Any other properties of the parameter are serialized into the HTTP requets body following the given/inferred content type." ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path schema:urlTemplate .

shaclmate:OperationHttpRequestBindingContentType
    a sh:NodeShape ;
    sh:in ("application/json"
    ) .

shaclmate:OperationHttpResultResponseBinding
    a rdfs:Class, sh:NodeShape ;
    rdfs:comment "HTTP binding for the result of an operation." ;
    sh:property shaclmate:OperationHttpResultResponseBinding-contentType, shaclmate:OperationHttpResultResponseBinding-statusCode .

shaclmate:OperationHttpResultResponseBinding-contentType
    a sh:PropertyShape ;
    rdfs:comment "HTTP result response body content type. If not specified, it's inferred from the request method and content type." ;
    sh:maxCount 1 ;
    sh:node shaclmate:OperationHttpResultResponseBindingContentType ;
    sh:path schema:contentType .

shaclmate:OperationHttpResultResponseBinding-statusCode
    a sh:PropertyShape ;
    rdfs:comment "HTTP result response status code. If not specified, it defaults to 200." ;
    sh:maxCount 1 ;
    sh:name "statusCode" ;
    sh:node shaclmate:HttpResponseSuccessfulStatusCode ;
    sh:path shaclmate:httpStatusCode .

shaclmate:OperationHttpResultResponseBindingContentType
    a sh:NodeShape ;
    sh:in ("application/json"
    ) .

shaclmate:PropertyShape
    sh:property shaclmate:PropertyShape-display, shaclmate:PropertyShape-resolve, shaclmate:Shape-ignore, shaclmate:Shape-mutable, shaclmate:Shape-shaclmateName .

shaclmate:PropertyShape-display
    a sh:PropertyShape ;
    rdfs:comment "Whether to include this property in a toString()-type display, defaults to false" ;
    sh:datatype xsd:boolean ;
    sh:defaultValue false ;
    sh:maxCount 1 ;
    sh:path shaclmate:display .

shaclmate:PropertyShape-resolve
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:name "resolve" ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path shaclmate:resolve .

shaclmate:Service
    a rdfs:Class, sh:NodeShape ;
    rdfs:comment "Service with operations" ;
    sh:property shaclmate:Service-name, shaclmate:Service-operations, shaclmate:comment, shaclmate:label .

shaclmate:Service-name
    shaclmate:display true ;
    a sh:PropertyShape ;
    rdfs:comment "Identifier-safe name of the service" ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:path shaclmate:name .

shaclmate:Service-operations
    a sh:PropertyShape ;
    rdfs:comment "Set of operations associated with the service" ;
    sh:node shaclmate:Operation ;
    sh:path shaclmate:operation .

shaclmate:Shape-ignore
    a sh:PropertyShape ;
    rdfs:comment "Whether to ignore this shape in code generation, defaults to false" ;
    sh:datatype xsd:boolean ;
    sh:defaultValue false ;
    sh:maxCount 1 ;
    sh:path shaclmate:ignore .

shaclmate:Shape-mutable
    a sh:PropertyShape ;
    rdfs:comment "Whether the code generated from the shape should be mutable e.g., a mutable property, a mutable array, etc." ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:path shaclmate:mutable .

shaclmate:Shape-shaclmateName
    shaclmate:display true ;
    a sh:PropertyShape ;
    rdfs:comment "Name to use in generated code. Used on node shapes (which don't permit sh:name) and to override sh:name in property shapes." ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:name "shaclmateName" ;
    sh:path shaclmate:name .

